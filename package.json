{
  "name": "kk-appstate-viewer",
  "version": "0.1.3",
  "description": "KakaoTalk Windows appstate 根钥解包与聊天记录查看（本地）",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test:crypto": "node electron/selftest.cjs",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.vipkid.kkappstateviewer",
    "productName": "KK AppState Viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "js/**/*",
      "vendor/**/*",
      "css/**/*",
      "index.html",
      "!electron/**/*.test.cjs"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "KK-AppState-Viewer-portable.${ext}"
    },
    "portable": {
      "artifactName": "KK-AppState-Viewer-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
